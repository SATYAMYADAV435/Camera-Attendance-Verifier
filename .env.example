APP_ENV=development
# Demo defaults only — replace JWT_SECRET_KEY and
# BIOMETRIC_ENCRYPTION_KEY with your own random 32-byte values before
# any production / network-exposed use. The biometric key below is the
# same demo value shipped in configs/development.yaml.
JWT_SECRET_KEY=your-32-byte-secret-key-goes-here-for-jwt-tokens!
BIOMETRIC_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ELASTICSEARCH_HOST=http://localhost:9200
REDIS_HOST=localhost
LOG_LEVEL=INFO
